  "description": "Research project analyzing Solana ecosystem tokens using Codex.io API - market cap milestones, holder P&L, and token survival rates",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "discover": "tsx src/scripts/discover-tokens.ts",
    "trajectory": "tsx src/scripts/analyze-trajectory.ts",
    "holders": "tsx src/scripts/analyze-holders.ts",

# ─── Required ─────────────────────────────────────────────────────────
# Get your API key at https://dashboard.codex.io
CODEX_API_KEY=your_api_key_here

# ─── Optional (defaults shown) ───────────────────────────────────────
# Solana network ID in Codex.io
SOLANA_NETWORK_ID=1399811149

# Market cap threshold in USD
MARKET_CAP_THRESHOLD=10000000

# Liquidity survival threshold in USD
LIQUIDITY_SURVIVAL_THRESHOLD=100000

# HTTP server port (Railway injects this automatically)
PORT=3000

# Re-run analysis every N hours (omit to run once only)
CRON_INTERVAL_HOURS=24

# Directory for persistent data (Railway: mount a volume at /data)
DATA_DIR=/data
